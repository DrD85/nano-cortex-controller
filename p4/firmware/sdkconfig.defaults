# P4 board: Waveshare ESP32-P4-WIFI6-Touch-LCD-7B
CONFIG_IDF_TARGET="esp32p4"
# Flash: 16 MB at least (check the size on the board: esptool flash-id)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Serial monitor on the USB-C port of the P4 (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM holds the two 1024x600 frame buffers, the screen's objects and the long Nano replies
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_FREERTOS_HZ=1000
# The start-up (app_main) left 1 KB of the default 3.5 KB; the memory is given back when it has finished
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Own partition table: two 4.5 MB firmware places (updates over Wi-Fi), store, pedal pictures (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new firmware has to say it works (p4_ota_confirm), else the next start goes back to the one before
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# USB host: the Nano on the high-speed USB-A port (audio class 2 isochronous + HID)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# LVGL (as on the 4.3" board)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=24
CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=64
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=48
CONFIG_LV_USE_CUSTOM_MALLOC=y

# microSD card (jam tracks): long file names, UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Wi-Fi through the ESP32-C6 (esp_hosted over SDIO, slot 1: CLK 18, CMD 19, D0-D3 14-17, C6 reset 54 - the defaults)
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Bluetooth LE through the ESP32-C6 (stage f): NimBLE runs on the P4, the controller in the C6 (esp_hosted, VHCI over
# the same SDIO link as the Wi-Fi). The NimBLE settings are the small board's.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=40
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
# NimBLE's host on core 1: core 0 belongs to the USB audio
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
# Internal RAM is short (the sound path lives there): NimBLE's memory and esp_hosted's transport buffers in PSRAM.
# Measured 2026-11-19: 42 KB internal left and a largest DMA block of 6 KB once Bluetooth ran.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Nano Cortex Controller"
# P4, measured 2026-11-19 (drawing time per refresh, unsent USB audio packets while the screen works):
# - two drawing threads (CONFIG_LV_OS_FREERTOS, CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2): no faster - drawing waits on the
#   PSRAM, not on the CPU;
# - the PPA for plain fills (CONFIG_LV_USE_PPA, needs CONFIG_LV_DRAW_BUF_ALIGN=64): 20-25 % faster, but twice the
#   unsent audio packets (43 against 19 in the same two minutes) - left off, the sound comes first.
