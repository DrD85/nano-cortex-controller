# Bluetooth audio bridge on a classic ESP32 (ESP-WROOM-32 NodeMCU, CH340)
CONFIG_IDF_TARGET="esp32"
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SSP_ENABLED=y
# FreeRTOS at its default 100 Hz, as Espressif's sink example
# 1 MB was 93 % full: one large app partition
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# 240 MHz: room for the SBC decoding next to the Bluetooth host and controller on core 0
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# A lost packet must not cost a log line: each one held the Bluetooth host about 7 ms on the console (115200 baud)
CONFIG_BT_LOG_APPL_TRACE_LEVEL_ERROR=y
