CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-Touch-LCD-4.3: 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Serial monitor on the native "USB" port (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth LE central (NimBLE) for the Nano Cortex
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# 8 MB octal PSRAM holds the two 800x480 frame buffers. Code and constants run from PSRAM too,
# so the display keeps running while flash is written (e.g. Bluetooth bonding data).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# Small allocations (most screen objects) up to 4 KB prefer internal RAM; larger ones go to PSRAM. Internal RAM
# must stay free for Bluetooth (its host task and buffers need it).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_FREERTOS_HZ=1000

# Own partition table: 6 MB app partition on the 16 MB flash (LVGL, icons and the TTF font)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL fonts used by the UI
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# Large tuner note from a TTF (Montserrat) instead of a scaled bitmap font
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=24
CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=64

# Smooth display: optimized code, larger caches for the PSRAM frame buffers, LVGL at ~60 Hz
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_LV_DEF_REFR_PERIOD=16
# Corner masks of every radius in use stay cached (the default 4 is fewer than the UI uses, so they were computed
# again on every frame), and the glow of the lit tiles is blurred once instead of on every redraw.
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=48

# LVGL objects from the normal heap (internal RAM, then PSRAM) for long lists
CONFIG_LV_USE_CLIB_MALLOC=y
# Two connections (Nano + Bluetooth MIDI) and long replies: more host buffers
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=40
# App bridge: the controller also acts as a Nano for the Mac app (peripheral + GATT server), and as a Bluetooth MIDI
# device for a looper app on a phone; connections: Nano, MIDI controller, app, phone
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Nano Cortex Controller"
